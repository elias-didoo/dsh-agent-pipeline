{
  "name": "dsh-agent-pipeline",
  "version": "0.1.0",
  "description": "Run a workspace's fixed review pipeline in DeepSeek Harness: each step fires when the agent finishes the last one, and the pipeline pauses where you have to decide.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "workflow",
    "pipeline",
    "orchestration"
  ],
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "client.js",
    "lib",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/all.mjs",
    "test:fast": "node test/all.mjs --fast",
    "typecheck": "./test/typecheck.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "immediately": true
    }
  }
}
