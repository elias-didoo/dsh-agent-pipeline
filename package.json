{
  "name": "dsh-agent-pipeline",
  "version": "0.1.0",
  "type": "module",
  "description": "Run a workspace's fixed review pipeline in DeepSeek Harness: each step fires when the agent finishes the last one, and the pipeline pauses where you have to decide.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pipeline",
    "workflow",
    "code-review",
    "ai-agent"
  ],
  "homepage": "https://github.com/elias-didoo/dsh-agent-pipeline#readme",
  "bugs": {
    "url": "https://github.com/elias-didoo/dsh-agent-pipeline/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elias-didoo/dsh-agent-pipeline.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/all.mjs",
    "test:fast": "node test/all.mjs --fast",
    "typecheck": "./test/typecheck.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu"
      ],
      "immediately": true
    }
  }
}
